## replay the simulation with the incremental store
rel <- rel_new(300)
size <- integer(41)
for (t in 0:40) {
  rel_add(rel, pop[pop$arrival == t, c("id", "momid", "dadid")])
  rel_remove(rel, pop$id[!is.na(pop$exit) & pop$exit == t])
